# =====================================================
# CURLEA LUXE - Environment Variables Template
# =====================================================
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env"
# 2. Fill in your actual Supabase keys below
# 3. NEVER commit the .env file to git (it's in .gitignore)
#
# =====================================================

# Supabase Project URL
# Get from: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://vfhxwzcbjdlfmizakvqc.supabase.co

# Supabase Anonymous (Public) Key
# Get from: Supabase Dashboard → Settings → API → Project API keys → anon public
# This key is safe to expose in client-side code
# It should start with: eyJ...
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (KEEP SECRET!)
# Get from: Supabase Dashboard → Settings → API → Project API keys → service_role
# NEVER expose this key in client-side code!
# It should start with: eyJ...
SUPABASE_SERVICE_ROLE_SECRET=your-service-role-key-here

# Analytics Edge Function Endpoint
# Format: https://YOUR_PROJECT_REF.supabase.co/functions/v1/track
VITE_ANALYTICS_ENDPOINT=https://vfhxwzcbjdlfmizakvqc.supabase.co/functions/v1/track

# =====================================================
# STRIPE PAYMENT INTEGRATION
# =====================================================

# Stripe Secret Key (for Supabase Edge Functions)
# Get from: Stripe Dashboard → Developers → API keys
# Use sk_test_xxx for testing, sk_live_xxx for production
# NEVER expose this key in client-side code!
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (for verifying webhooks)
# Get from: Stripe Dashboard → Developers → Webhooks
# Click "Add endpoint" and copy the signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =====================================================
# EXAMPLE (DO NOT USE THESE):
# =====================================================
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI...
# SUPABASE_SERVICE_ROLE_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI...
#
# =====================================================
# 
# How to get your keys:
#
# SUPABASE:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project (vfhxwzcbjdlfmizakvqc)
# 3. Click "Settings" in the left sidebar
# 4. Click "API" under Project Settings
# 5. Copy both keys from the "Project API keys" section
#
# STRIPE:
# 1. Go to https://dashboard.stripe.com
# 2. Sign up or log in
# 3. Click "Developers" → "API keys"
# 4. Copy your "Secret key" (use test key for development)
# 5. For webhooks: Click "Developers" → "Webhooks"
# 6. Click "Add endpoint" and copy the "Signing secret"
#
# IMPORTANT:
# - Use test keys (sk_test_...) during development
# - Use live keys (sk_live_...) for production
# - Never commit these keys to Git
# - Add .env to .gitignore
#
# =====================================================

